# Canonical Docker PostGIS target exposed only on the local host.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=nexio_commerce
POSTGRES_USER=nexio_admin
POSTGRES_PASSWORD=replace_with_a_strong_admin_password
POSTGRES_APP_USER=nexio_app
POSTGRES_APP_PASSWORD=replace_with_a_distinct_strong_app_password

DATABASE_URL=postgresql://nexio_admin:replace_with_a_strong_admin_password@localhost:5433/nexio_commerce?schema=public
APP_DATABASE_URL=postgresql://nexio_app:replace_with_a_distinct_strong_app_password@localhost:5433/nexio_commerce?schema=public

REDIS_HOST_PORT=6379
REDIS_PASSWORD=replace_with_a_strong_redis_password
REDIS_URL=redis://:replace_with_a_strong_redis_password@localhost:6379

PORT=3001
NODE_ENV=production
SEED_ADMIN_PASSWORD=replace_with_a_strong_seed_admin_password
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
CORS_ORIGINS=https://store.example.com,https://admin.example.com
