datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKED
  AUTHORIZED
  PARTIALLY_FULFILLED
  FULFILLED
  SHIPPED
  DELIVERED
  COMPLETED
  RETURNED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  PACKED
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  RETURNED
}

enum TransactionStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum ShipmentStatus {
  DRAFT
  PENDING
  PREPARED
  LABEL_GENERATED
  PACKED
  DISPATCHED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED
  CANCELLED
}

model Tenant {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String       @db.VarChar(255)
  subdomain        String       @unique @db.VarChar(100)
  customDomain     String?      @unique @map("custom_domain") @db.VarChar(255)
  status           TenantStatus @default(PENDING)
  subscriptionTier String       @default("BASIC") @map("subscription_tier") @db.VarChar(50)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users        User[]
  stores       Store[]
  branches     Branch[]
  warehouses   Warehouse[]
  categories   Category[]
  products     Product[]
  variants     ProductVariant[]
  stockLevels  StockLevel[]
  customers    Customer[]
  carts        Cart[]
  cartItems    CartItem[]
  checkouts    Checkout[]
  orders       Order[]
  orderItems   OrderItem[]
  transactions Transaction[]
  shipments      Shipment[]
  shipmentTrackingHistories ShipmentTrackingHistory[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  orderTimelines       OrderTimeline[]
  payments             Payment[]
  paymentWebhookEvents PaymentWebhookEvent[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  provinces            Province[]
  deliveryZones        DeliveryZone[]
  installmentContracts InstallmentContract[]
  journalEntries       JournalEntry[]
  brands               Brand[]
  productImages        ProductImage[]
  attributeDefinitions AttributeDefinition[]

  @@map("tenants")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(255)
  roleId       String   @map("role_id") @db.VarChar(50)
  status       String   @default("ACTIVE") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, roleId])
  @@map("users")
}

model Store {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(255)
  currency        String   @default("USD") @db.VarChar(3)
  languageDefault String   @default("en") @map("language_default") @db.VarChar(5)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branches BranchesOnStores[]
  products Product[]
  carts    Cart[]
  checkouts Checkout[]
  orders   Order[]
  payments Payment[]
  shipments Shipment[]

  @@index([tenantId])
  @@map("stores")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(255)
  address   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stores     BranchesOnStores[]
  warehouses Warehouse[]

  @@index([tenantId])
  @@map("branches")
}

// Join table for Store <-> Branch relation
model BranchesOnStores {
  tenantId String @map("tenant_id") @db.Uuid
  storeId  String @map("store_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([tenantId, storeId, branchId])
  @@map("branches_stores")
}

model Warehouse {
  id              String                                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                                  @map("tenant_id") @db.Uuid
  branchId        String?                                 @map("branch_id") @db.Uuid
  name            String                                  @db.VarChar(255)
  locationPolygon Unsupported("geometry(Polygon, 4326)")? @map("location_polygon")
  isActive        Boolean                                 @default(true) @map("is_active")
  createdAt       DateTime                                @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  stockLevels StockLevel[]
  stockMovements StockMovement[]

  @@index([tenantId])
  @@map("warehouses")
}

model Category {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  parentId                String?  @map("parent_id") @db.Uuid
  nameTranslations        Json     @map("name_translations")
  descriptionTranslations Json?    @map("description_translations")
  slug                    String   @db.VarChar(100)
  imageUrl                String?  @map("image_url") @db.VarChar(1024)
  metaTitle               String?  @map("meta_title") @db.VarChar(255)
  metaDescription         String?  @map("meta_description") @db.VarChar(500)
  isActive                Boolean  @default(true) @map("is_active")
  position                Int      @default(0)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children             Category[]             @relation("CategoryHierarchy")
  products             CategoriesOnProducts[]
  attributeDefinitions AttributeDefinition[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive, position])
  @@map("categories")
}

model Brand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @db.VarChar(100)
  logoUrl     String?  @map("logo_url") @db.VarChar(1024)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("brands")
}

model Product {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  storeId                 String    @map("store_id") @db.Uuid
  brandId                 String?   @map("brand_id") @db.Uuid
  titleTranslations       Json      @map("title_translations")
  descriptionTranslations Json?     @map("description_translations")
  attributes              Json?
  slug                    String?   @db.VarChar(255)
  metaTitle               String?   @map("meta_title") @db.VarChar(255)
  metaDescription         String?   @map("meta_description") @db.VarChar(500)
  isPublished             Boolean   @default(false) @map("is_published")
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  tsvSearch               Unsupported("tsvector")? @map("tsv_search")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand  Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  variants   ProductVariant[]
  categories CategoriesOnProducts[]
  images     ProductImage[]

  @@unique([tenantId, slug])
  @@index([tenantId, storeId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  url       String   @db.VarChar(1024)
  altText   String?  @map("alt_text") @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@index([productId, isPrimary])
  @@map("product_images")
}

// Join table for Product <-> Category relation
model CategoriesOnProducts {
  tenantId   String @map("tenant_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tenantId, productId, categoryId])
  @@map("categories_products")
}

model ProductVariant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String   @db.VarChar(100)
  barcode        String?  @db.VarChar(100)
  price          Decimal  @db.Decimal(12, 4)
  costPrice      Decimal? @map("cost_price") @db.Decimal(12, 4)
  priceOverride  Decimal? @map("price_override") @db.Decimal(12, 4)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 4)
  weight         Decimal? @db.Decimal(8, 3)
  variantName    String?  @map("variant_name") @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  position       Int      @default(0)
  dimensions     Json?
  attributes     Json?
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images         ProductImage[]
  stockLevels    StockLevel[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@index([tenantId, isActive, position])
  @@index([tenantId, price])
  @@map("product_variants")
}

model StockLevel {
  tenantId         String   @map("tenant_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  quantityPhysical Int      @default(0) @map("quantity_physical")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([tenantId, warehouseId, variantId])
  @@map("stock_levels")
}

model Customer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  phone        String?  @db.VarChar(50)
  name         String   @db.VarChar(255)
  address      Json?
  totalOrders  Int      @default(0) @map("total_orders")
  totalSpent   Decimal  @default(0) @map("total_spent") @db.Decimal(12, 4)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  carts                Cart[]
  checkouts            Checkout[]
  orders               Order[]
  installmentContracts InstallmentContract[]

  @@unique([tenantId, email])
  @@index([tenantId, phone])
  @@map("customers")
}

enum CartStatus {
  ACTIVE
  MERGED
  EXPIRED
  CONVERTED
  ABANDONED
}

model Cart {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  storeId    String     @map("store_id") @db.Uuid
  customerId String?    @map("customer_id") @db.Uuid
  sessionId  String?    @map("session_id") @db.VarChar(255)
  status     CartStatus @default(ACTIVE)
  currency   String     @default("USD") @db.VarChar(3)
  subtotal   Decimal    @default(0) @db.Decimal(12, 4)
  discount   Decimal    @default(0) @db.Decimal(12, 4)
  tax        Decimal    @default(0) @db.Decimal(12, 4)
  shipping   Decimal    @default(0) @db.Decimal(12, 4)
  total      Decimal    @default(0) @db.Decimal(12, 4)
  couponCode String?    @map("coupon_code") @db.VarChar(50)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items CartItem[]
  checkouts Checkout[]

  @@index([tenantId, customerId])
  @@index([tenantId, sessionId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @default(0) @map("unit_price") @db.Decimal(12, 4)
  subtotal  Decimal  @default(0) @db.Decimal(12, 4)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cartId, variantId])
  @@map("cart_items")
}

enum CheckoutStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

model Checkout {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  storeId         String         @map("store_id") @db.Uuid
  cartId          String         @map("cart_id") @db.Uuid
  customerId      String?        @map("customer_id") @db.Uuid
  currency        String         @default("USD") @db.VarChar(3)
  subtotal        Decimal        @default(0) @db.Decimal(12, 4)
  discount        Decimal        @default(0) @db.Decimal(12, 4)
  tax             Decimal        @default(0) @db.Decimal(12, 4)
  shipping        Decimal        @default(0) @db.Decimal(12, 4)
  total           Decimal        @default(0) @db.Decimal(12, 4)
  status          CheckoutStatus @default(DRAFT)
  customerInfo    Json?          @map("customer_info")
  billingAddress  Json?          @map("billing_address")
  shippingAddress Json?          @map("shipping_address")
  shippingMethod  Json?          @map("shipping_method")
  couponCode      String?        @map("coupon_code") @db.VarChar(50)
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cart     Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, cartId])
  @@index([tenantId, storeId])
  @@index([tenantId, customerId])
  @@map("checkouts")
}

model Order {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  storeId           String            @map("store_id") @db.Uuid
  checkoutId        String?           @map("checkout_id") @db.Uuid
  cartId            String?           @map("cart_id") @db.Uuid
  customerId        String            @map("customer_id") @db.Uuid
  orderNumber       String            @map("order_number") @db.VarChar(50)
  currency          String            @default("USD") @db.VarChar(3)
  status            OrderStatus       @default(DRAFT)
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  subtotal          Decimal           @db.Decimal(12, 4)
  discount          Decimal           @default(0) @db.Decimal(12, 4)
  taxTotal          Decimal           @map("tax_total") @db.Decimal(12, 4)
  shippingTotal     Decimal           @map("shipping_total") @db.Decimal(12, 4)
  grandTotal        Decimal           @map("grand_total") @db.Decimal(12, 4)
  shippingAddress   Json              @map("shipping_address")
  billingAddress    Json?             @map("billing_address")
  notes             String?           @db.VarChar(1000)
  metadata          Json?
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items        OrderItem[]
  transactions Transaction[]
  shipments            Shipment[]
  timelines            OrderTimeline[]
  payments             Payment[]
  installmentContracts InstallmentContract[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, customerId])
  @@index([tenantId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  sku         String? @db.VarChar(100)
  productName String? @map("product_name") @db.VarChar(255)
  variantName String? @map("variant_name") @db.VarChar(255)
  priceUnit   Decimal @map("price_unit") @db.Decimal(12, 4)
  quantity    Int
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  subtotal    Decimal @default(0) @db.Decimal(12, 4)
  metadata    Json?

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([tenantId, id])
  @@map("order_items")
}

model Transaction {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  orderId              String            @map("order_id") @db.Uuid
  gateway              String            @db.VarChar(50)
  gatewayTransactionId String            @map("gateway_transaction_id") @db.VarChar(255)
  amount               Decimal           @db.Decimal(12, 4)
  status               TransactionStatus
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, gateway, gatewayTransactionId])
  @@map("transactions")
}

model Shipment {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  storeId                String?        @map("store_id") @db.Uuid
  orderId                String         @map("order_id") @db.Uuid
  fulfillmentId          String?        @map("fulfillment_id") @db.Uuid
  carrier                String         @db.VarChar(50)
  serviceLevel           String?        @map("service_level") @db.VarChar(50)
  trackingNumber         String         @map("tracking_number") @db.VarChar(100)
  shippingLabelReference String?        @map("shipping_label_reference") @db.VarChar(255)
  estimatedDeliveryDate  DateTime?      @map("estimated_delivery_date") @db.Timestamptz
  shippedAt              DateTime?      @map("shipped_at") @db.Timestamptz
  deliveredAt            DateTime?      @map("delivered_at") @db.Timestamptz
  status                 ShipmentStatus @default(PENDING)
  shippingCost           Decimal        @default(0) @map("shipping_cost") @db.Decimal(12, 4)
  metadata               Json?
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store   Store?                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order   Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  history ShipmentTrackingHistory[]

  @@index([tenantId, trackingNumber])
  @@index([tenantId, orderId])
  @@map("shipments")
