{
  "name": "nexio-commerce",
  "version": "1.0.0",
  "description": "Enterprise Multi-Tenant Headless SaaS E-Commerce Platform Backend Core",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,storefront,admin --prefix-colors blue,magenta,cyan \"npm:start:dev\" \"npm:dev:storefront\" \"npm:dev:admin\"",
    "dev:storefront": "npm --prefix nexio-storefront run dev",
    "dev:admin": "npm --prefix admin-dashboard run dev",
    "build": "npm run build:backend && npm run build:storefront && npm run build:admin",
    "build:backend": "nest build",
    "build:storefront": "npm --prefix nexio-storefront run build",
    "build:admin": "npm --prefix admin-dashboard run build",
    "format": "prettier --write \"{src,test,scripts,nexio-storefront/src,admin-dashboard/src}/**/*.{ts,tsx,js,cjs,mjs,json,css}\" \"*.{json,mjs,yml}\"",
    "format:check": "prettier --check \"{src,test,scripts,nexio-storefront/src,admin-dashboard/src}/**/*.{ts,tsx,js,cjs,mjs,json,css}\" \"*.{json,mjs,yml}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npm run lint:backend && npm run lint:storefront && npm run lint:admin",
    "lint:backend": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:storefront": "npm --prefix nexio-storefront run lint",
    "lint:admin": "npm --prefix admin-dashboard run lint",
    "lint:fix": "npm run lint:backend -- --fix && npm --prefix nexio-storefront run lint -- --fix && npm --prefix admin-dashboard run lint -- --fix",
    "typecheck": "npm run typecheck:backend && npm run typecheck:storefront && npm run typecheck:admin",
    "typecheck:backend": "tsc --noEmit",
    "typecheck:storefront": "npm --prefix nexio-storefront run typecheck",
    "typecheck:admin": "npm --prefix admin-dashboard run typecheck",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "e2e": "npm run test:e2e",
    "system:start": "node scripts/start-system.cjs",
    "system:provision-admin": "node scripts/provision-platform-admin.cjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:inspect": "prisma studio",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.12.1",
    "argon2": "^0.45.0",
    "bullmq": "^5.41.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^5.12.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.\\.?/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
